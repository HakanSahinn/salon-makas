{
  "expo": {
    "name": "Salon Makas",
    "slug": "berber",
    "version": "2.0.1",
    "plugins": [
      "./plugins/withAndroidBuild.cjs",
      "expo-status-bar"
    ],
    "orientation": "portrait",
    "icon": "./assets/salonum-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/salonum-icon.png",
        "backgroundColor": "#193C32"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.berber.randevu"
    },
    "web": {
      "favicon": "./assets/salonum-icon.png"
    }
  }
}
